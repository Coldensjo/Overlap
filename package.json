    "start": "tsx server/index.ts"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "luxon": "^3.7.2"
  }
}
