{
  "name": "overlap",
  "version": "1.0.0",
  "description": "Compare one or two ICS calendars on a week or month grid",
  "type": "module",
  "license": "MIT",
  "keywords": ["ics", "calendar", "availability", "quinyx", "schedule"],
  "scripts": {
